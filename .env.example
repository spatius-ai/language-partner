# Required: from app.spatius.ai
SPATIUS_API_KEY=
SPATIUS_APP_ID=
# us-west (default) or your region
SPATIUS_REGION=us-west

# Optional: your own OpenAI key. Without it, the partner uses 30 free Spatius starter minutes.
OPENAI_API_KEY=

# Optional: ElevenLabs voices (each person has their own voice, with a native voice for Arabic).
# Without it, the OpenAI voice is used. Your key needs text-to-speech access.
ELEVENLABS_API_KEY=

# Optional: where the page starts (the learner can still change everything)
# Language: es, en, zh, ar, fr    Level: beginner, intermediate, advanced
# Place: cafe, hotel, train, lesson    Partner: camille, nadia, grace, victor, julian
PARTNER_LANG=es
PARTNER_LEVEL=beginner
PARTNER_SCENE=cafe
PARTNER_FACE=camille
# Your own lesson for the "My lesson" place. Write \n for a new line.
# PARTNER_LESSON=Unit 4: at the café\ncafé con leche, para llevar, la cuenta
# PORT=3000
